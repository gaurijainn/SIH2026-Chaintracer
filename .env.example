# live | record | replay  (replay = serve every external call from fixtures/, works offline)
DATA_MODE=replay

# --- Provider keys (Section 3). Never commit real values. ---
TRONGRID_KEY=
TRONSCAN_KEY=
ETHERSCAN_KEY=
MEGANODE_KEY=
BLOCKSCOUT_KEY=
ALCHEMY_KEY=
CHAINABUSE_KEY=
COINGECKO_DEMO_KEY=
# Optional TRON failover RPC (Chainstack / Ankr)
ANKR_KEY=

# --- Infrastructure ---
DATABASE_URL=postgresql://ps26183:ps26183@postgres:5432/ps26183
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ps26183-neo4j
REDIS_URL=redis://redis:6379
ML_URL=http://ml:8000

# --- Security ---
JWT_SECRET=change-me
PII_ENC_KEY=change-me

# --- Trace defaults ---
TRACE_MAX_HOPS=6
TRACE_MIN_USD=10
TRACE_WINDOW_DAYS=30
TRACE_TOP_K=10
HIGH_DEGREE_CUTOFF=5000

# --- Service ports / paths ---
API_PORT=4000
FIXTURES_DIR=/app/fixtures
