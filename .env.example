# live | record | replay  (replay = serve every external call from fixtures/, works offline)
DATA_MODE=replay

# --- Provider keys (Section 3). Never commit real values. ---
TRONGRID_KEY=
TRONSCAN_KEY=
ETHERSCAN_KEY=
MEGANODE_KEY=
BLOCKSCOUT_KEY=
ALCHEMY_KEY=
# B8: live ETH (chainid=1) USDT monitoring stays OFF until someone manually confirms the USDT contract
# address against Etherscan and sets this to true -- see workers/src/index.ts's USDT_EVM comment.
# BSC/POLYGON monitoring is unaffected by this flag.
ETH_USDT_CONTRACT_VERIFIED=false
CHAINABUSE_KEY=
COINGECKO_DEMO_KEY=
# Optional TRON failover RPC (Chainstack / Ankr)
ANKR_KEY=

# --- Infrastructure ---
DATABASE_URL=postgresql://ps26183:ps26183@postgres:5432/ps26183
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ps26183-neo4j
REDIS_URL=redis://redis:6379
ML_URL=http://ml:8000

# --- Security (B10) ---
# Both MUST be replaced: the API refuses to start with the placeholders. Never commit real values.
#   JWT_SECRET  : random string, >= 32 chars           (openssl rand -hex 32)
#   PII_ENC_KEY : 32-byte AES-256-GCM key, hex/base64  (openssl rand -hex 32)
# Losing PII_ENC_KEY makes every encrypted PII field unrecoverable; rotating it requires re-encrypting stored values.
JWT_SECRET=change-me
PII_ENC_KEY=change-me
JWT_ACCESS_TTL_S=900
JWT_REFRESH_TTL_S=604800
# Comma-separated browser origins allowed by CORS (no wildcard)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Per-IP limits: general API budget per window, and failed-login budget per window
RATE_LIMIT_WINDOW_S=60
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=10

# --- Trace defaults ---
TRACE_MAX_HOPS=6
TRACE_MIN_USD=10
TRACE_WINDOW_DAYS=30
TRACE_TOP_K=10
HIGH_DEGREE_CUTOFF=5000

# --- Mock NCRP/CFCFRMS feed (adapter; no public API exists) ---
NCRP_BASE_URL=http://mock-ncrp:4010
NCRP_POLL_INTERVAL_S=60

# --- Service ports / paths ---
API_PORT=4000
FIXTURES_DIR=/app/fixtures

# --- Provider layer (B3) ---
# Chainstack/Ankr TRON full node used as the backup for account creation time (put the key inside the URL)
TRON_BACKUP_URL=https://rpc.ankr.com/http/tron
# Optional JSON overriding per-provider limits, e.g. {"trongrid":{"rps":15,"dailyBudget":90000}}
PROVIDER_LIMITS=
